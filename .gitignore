__pycache__/
*.egg-info/
build/
.pytest_cache/
paper/cache/

# Only runs/starling is kept: the STARLING benchmark's results and figures.
runs/*
!runs/starling/

# Only the small tables the code reads. The frame store, timeseries and other large files are copied between machines by hand.
data/*
!data/README.md
!data/benchmark.csv
!data/benchmark_methods.csv
!data/md_fits.csv
!data/proteins.csv
